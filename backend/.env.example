# Скопируйте в backend/.env и заполните пустые значения (секреты — только в .env, не в git).
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8081

# PostgreSQL (роль и базы synagogue / synagogue_test)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=synagogue
DB_PASSWORD=
DB_DATABASE=synagogue
# e2e-тесты: та же роль, отдельная база (по умолчанию synagogue_test)
TEST_DB_DATABASE=synagogue_test

# JWT админки (обязателен: без него приложение не стартует)
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Редакторы: "email:bcrypthash,email2:hash". Хеш: npm run admin:hash -- <пароль>
ADMIN_USERS=

# Лимит отправок публичных форм с одного IP в минуту
FORMS_RATE_LIMIT=10
# Загруженные файлы (раздаются как /media/*)
UPLOAD_DIR=./uploads
# Касса: fake — тестовая заглушка
PAYMENT_MODE=fake
# Реальная касса не подключена (RealPaymentProvider — заготовка): PAYMENT_MODE=real роняет старт.
PAYMENT_SHOP_ID=
PAYMENT_SECRET_KEY=

# Swagger (/docs); в production закрывается basic-auth, если заданы логин и пароль
SWAGGER_ENABLED=true
SWAGGER_USER=
SWAGGER_PASSWORD=
