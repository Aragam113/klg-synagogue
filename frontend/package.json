{
  "name": "klg-synagogue-frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "codegen": "ts-node -P scripts/tsconfig.codegen.json scripts/generate-api.ts",
    "codegen:format": "ts-node -P scripts/tsconfig.codegen.json scripts/generate-api.ts && npm run format",
    "test": "jest",
    "smoke": "node e2e/smoke.mjs",
    "smoke:schedule": "node e2e/schedule-smoke.mjs",
    "smoke:content": "node e2e/content-smoke.mjs",
    "smoke:forms": "node e2e/forms-smoke.mjs",
    "smoke:sections": "node e2e/sections-smoke.mjs",
    "smoke:payments": "node e2e/payments-smoke.mjs",
    "build:scrub": "node scripts/build-scrub.mjs",
    "build:favicon": "node scripts/build-favicon.mjs",
    "smoke:home": "node e2e/home-smoke.mjs",
    "smoke:admin": "node e2e/admin-smoke.mjs",
    "smoke:mobile": "node e2e/mobile-smoke.mjs",
    "demo:snapshot": "node scripts/demo-snapshot.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "serve:demo": "node scripts/serve-demo.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/frank-ruhl-libre": "^0.4.1",
    "@expo-google-fonts/heebo": "^0.4.2",
    "@expo-google-fonts/onest": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@reduxjs/toolkit": "^2.11.2",
    "eslint-config-expo": "~10.0.0",
    "expo": "~54.0.31",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-router": "~6.0.22",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "i18next": "^25.8.0",
    "lenis": "^1.3.26",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.5.3",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.2",
    "uniwind": "^1.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@react-native/eslint-config": "^0.80.2",
    "@rtk-query/codegen-openapi": "^2.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.0",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@react-native-async-storage/.*|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|@reduxjs/.*|immer|redux|reselect|react-redux))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
